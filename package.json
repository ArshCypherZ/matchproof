{
  "name": "matchproof",
  "version": "1.0.0",
  "description": "Fixes orders left unpaid after a successful Razorpay payment. It finds the captured payment, updates the merchant order, checks both records agree, and leaves the rest in a review queue with the evidence attached.",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.23.0+sha512.f00082e5b283a199b74e079da28d155c008fe232f44c8a06ea7ddfa014ecf719fc362f790ecc67b28106ddac2afb24c49a9a079159da560b2ce7d1e98efd11af",
  "scripts": {
    "test": "vitest run",
    "verify": "bash scripts/verify-local.sh",
    "test:postgres": "RUN_POSTGRES_TESTS=1 vitest run tests/postgres.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests apps",
    "format:check": "prettier --check src tests apps",
    "lint": "eslint src tests vitest.config.mts drizzle.config.ts drizzle.sqlite.config.ts && pnpm --dir apps/web lint",
    "razorpay:verify": "tsx src/incident_commander/verify-razorpay.ts",
    "test:razorpay:e2e": "RUN_RAZORPAY_LIVE_E2E=1 node --env-file=.env node_modules/vitest/vitest.mjs run tests/razorpay-live-e2e.test.ts",
    "razorpay:webhook-server": "tsx src/incident_commander/webhook-server.ts",
    "demo": "tsx src/incident_commander/demo.ts",
    "evaluate:baseline": "node --import tsx src/evaluation/baseline.ts",
    "evaluate:full": "node --env-file=.env --import tsx src/evaluation/full-evaluation.ts",
    "db:generate": "drizzle-kit generate",
    "db:generate:sqlite": "drizzle-kit generate --config drizzle.sqlite.config.ts",
    "db:migrate": "drizzle-kit migrate",
    "dev": "pnpm --dir apps/web dev",
    "build": "pnpm --dir apps/web build --webpack"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@valkey/valkey-glide": "^2.5.1",
    "better-sqlite3": "^13.0.3",
    "bullmq": "^6.2.0",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "groq-sdk": "^1.5.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "razorpay": "^2.9.8",
    "tsx": "^4.23.12",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
