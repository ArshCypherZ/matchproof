# --- Razorpay (Test Mode) ---------------------------------------------
# API keys: https://dashboard.razorpay.com/app/keys
RAZORPAY_API_KEY=rzp_test_your_key_id
RAZORPAY_API_SECRET=your_test_key_secret
# Webhook signing secret: https://dashboard.razorpay.com/app/webhooks
# (Test Mode, "Active" webhook, same secret you enter in the dashboard)
RAZORPAY_WEBHOOK_SECRET=your_test_webhook_secret

# --- Evidence signing --------------------------------------------------
# HMAC key that signs the evidence the engine acts on.
# Any long random string, e.g.: openssl rand -hex 32
PROCESSOR_WEBHOOK_SECRET=any-long-random-string

# --- Advisory AI (optional) --------------------------------------------
# API key: https://console.groq.com/keys
# Leave GROQ_API_KEY empty to run without the AI tier.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# --- Storage and queue --------------------------------------------------
# These point at the ports docker-compose.yml publishes on localhost.
# Inside the container, Compose overrides both with its own service URLs.
DATABASE_URL=postgres://incident:incident@localhost:9998/incident_commander
REDIS_URL=redis://localhost:9997

# --- Ports and auth -----------------------------------------------------
# Webhook server port (pnpm razorpay:webhook-server). The dashboard
# always runs on 3000 locally, 3101 through Docker.
PORT=9999
# Optional bearer token for the dashboard API. Leave empty to disable.
API_TOKEN=
