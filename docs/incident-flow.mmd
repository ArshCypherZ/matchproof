---
config:
  theme: base
  themeVariables:
    background: "#f2eee5"
    fontFamily: "Helvetica, Arial, sans-serif"
    fontSize: "15px"
    primaryColor: "#fbf8f1"
    primaryBorderColor: "#cec7ba"
    primaryTextColor: "#181715"
    lineColor: "#625f59"
    clusterBkg: "#eee8dd"
    clusterBorder: "#cec7ba"
    edgeLabelBackground: "#f2eee5"
  flowchart:
    curve: "basis"
    nodeSpacing: "34"
    rankSpacing: "52"
---
flowchart TB
    PAY["Customer pays at Razorpay<br/>the money leaves their account"]
    MISS["The order stays unpaid —<br/>webhook lost, late, or conflicting"]
    EV["Pull both records:<br/>the Razorpay payment and the merchant order"]
    REC["Our reconciliation engine<br/>checks 9 things — amount, currency, order mapping,<br/>timing, duplicates, authenticity, and more"]
    GATE["The gate decides: is the fix<br/>provable from the facts we pulled?<br/>captures, refunds, payouts always blocked"]
    FIX["Order updated to paid<br/>runs once, cannot double-apply"]
    CHECK["Both records re-read"]
    DONE(["Closed and verified<br/>37 of 100, zero wrong fixes"])
    EXC["Exception queue — 63 of 100<br/>each keeps its evidence, owner, and reason"]
    AI["AI advisor, read-only<br/>names the missing fact,<br/>5 calls for the whole batch"]
    OPS["Operator review in the dashboard<br/>exceptions, batches, metrics"]

    PAY --> MISS --> EV --> REC --> GATE
    GATE -->|"yes, provable"| FIX
    FIX --> CHECK
    CHECK -->|"records agree"| DONE
    CHECK -->|"still broken"| EXC
    GATE -->|"cannot prove it"| EXC
    EXC --> OPS
    AI -.->|"what to check first"| OPS
    OPS -->|"approve: the same checks run again"| GATE

    classDef card fill:#fbf8f1,stroke:#cec7ba,color:#181715
    classDef start fill:#e8e1d5,stroke:#cec7ba,color:#181715
    classDef closed fill:#181715,stroke:#181715,color:#f2eee5
    classDef exception fill:#f3dfc4,stroke:#824c0b,color:#5c3608
    classDef ai fill:#c9dcff,stroke:#4f70ee,color:#18213d

    class PAY,MISS,EV,REC,GATE,FIX,CHECK,OPS card
    class DONE closed
    class EXC exception
    class AI ai
